# ===== Harness Configuration =====
# 复制此文件为 .env 并填入你的真实配置
#   cp .env.example .env

# Service
PORT=8001

# LLM (必填 — 填入你的 API Key 和模型偏好)
DEFAULT_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_THINKING=false

# Embedding API（mem0 embedder 用 — 可选）
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=

# Middleware
SANDBOX_IMAGE=python:3.12
TOOL_MAX_RETRIES=3
MAX_CONCURRENT_SUBAGENTS=3

# Observability (Langfuse — 可选, 留空则禁用)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Web Search API Keys (可选)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# GitHub Token (用于 GitHub MCP Server — 可选)
GITHUB_TOKEN=
