# ===== App 服务配置 (端口 8000) =====
# 复制此文件为 .env 并填入真实配置 (或运行 ./setup.sh 自动生成)
#
# 注意: 模型 API (OPENAI_API_KEY / OPENAI_BASE_URL / DEFAULT_MODEL) 不在此文件,
# 由 harness/.env 统一配置, 对所有用户生效。

JWT_SECRET=change-me-in-production-use-random-string
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000

# 数据库 (SQLite 留空即可, PostgreSQL 需填写)
DATABASE_URL=
DATABASE_URL_SYNC=

HARNESS_URL=http://localhost:8001
WORKSPACE_ROOT=~/.multiagent-studio/workspace
HARNESS_DATA_ROOT=~/.multiagent-studio

# 服务间内部接口共享密钥 (app 与 harness/.env 需一致, Agent 自建定时任务用)
INTERNAL_API_TOKEN=

# 定时任务调度器 (默认值, 按需调整)
# SCHEDULER_ENABLED=true
# SCHEDULER_TICK_INTERVAL=15
# SCHEDULER_MAX_CONCURRENCY=20
# SCHEDULER_RUN_TIMEOUT=1800
# SCHEDULER_MAX_JOBS_PER_USER=50
