# ===== App 服务配置 =====
JWT_SECRET=change-me-in-production-use-random-string
JWT_ALGORITHM=HS256
UPLOAD_MAX_SIZE_MB=50
WORKSPACE_ROOT=/workspace

# ===== Harness 服务配置 =====
HARNESS_PORT=8001
HARNESS_DEFAULT_MODEL=gpt-4o
HARNESS_SUMMARY_MODEL=gpt-4o-mini
HARNESS_TITLE_MODEL=gpt-4o-mini
HARNESS_JUDGE_MODEL=gpt-4o
HARNESS_OPENAI_API_KEY=sk-your-api-key
HARNESS_OPENAI_BASE_URL=https://api.openai.com/v1
HARNESS_SANDBOX_IMAGE=python:3.11-slim
HARNESS_MAX_CONCURRENT_SUBAGENTS=3
HARNESS_DEBOUNCE_SECONDS=30.0

# ===== Langfuse 配置 =====
HARNESS_LANGFUSE_ENABLED=false
HARNESS_LANGFUSE_PUBLIC_KEY=pk-...
HARNESS_LANGFUSE_SECRET_KEY=sk-...
HARNESS_LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse
LANGFUSE_SALT=change-me-langfuse

# ===== 数据库配置 =====
DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/multiagent_studio
DATABASE_URL_SYNC=postgresql://harness:harness@localhost:5432/multiagent_studio
REDIS_URL=redis://localhost:6379/0
